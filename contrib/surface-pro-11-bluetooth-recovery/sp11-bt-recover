#!/bin/sh
# btintel_pcie sometimes brings the controller up dead at boot:
#   Bluetooth: hciN: Unsupported cnvi 0x00000000
#   Bluetooth: hciN: Controller in error state
# leaving the adapter DOWN with BD address 00:00:00:00:00:00. A mailbox
# interrupt arrives during the firmware download before the driver is waiting
# for it. Reloading the module recovers it, but only once the firmware setup
# has given up.
# Poll rather than sleeping a flat 20 s. The controller settles in a couple of
# seconds when it is healthy, and this used to add the full 20 s to every boot.
DEV=/sys/bus/pci/devices/0000:00:14.7
MOD=/sys/module/btintel_pcie
[ -d "$DEV" ] || exit 0

# The first BD address that is not all zeros, or nothing.
real_addr() {
	hciconfig 2>/dev/null | grep -oE "BD Address: [0-9A-F:]+" | cut -d' ' -f3 |
		grep -m1 -v "^00:00:00:00:00:00$"
}

# The firmware setup runs after the probe has returned, at 00:00:00:00:00:00
# throughout. A failing one takes about 8 s to give up, and one saved by the
# driver's own retry about 5 s. Unloading in the middle of it frees the
# interrupts under it, and the probe of the next load then fails with -62 and
# leaves no adapter at all: the previous version, which reloaded on the first
# zero address, lost every race boot that way. So a zero address is a verdict
# only after 15 s. No driver bound means a probe failed and nothing is
# running, so reload at once, as soon as the module's init has returned
# (modprobe -r refuses it before).
why=
i=0; noaddr=0
while [ $i -lt 60 ]; do
	[ -n "$(real_addr)" ] && exit 0                   # healthy, nothing to do
	if [ "$(cat "$MOD/initstate" 2>/dev/null)" = live ]; then
		[ -e "$DEV/driver" ] || { why="no driver bound"; break; }
		[ $noaddr -ge 15 ] && { why="no address for 15 s"; break; }
		noaddr=$((noaddr+1))
	fi
	sleep 1; i=$((i+1))
done
if [ -z "$why" ]; then
	state=$(cat "$MOD/initstate" 2>/dev/null)
	if [ -z "$state" ]; then
		logger -t sp11-bt-recover "btintel_pcie is not loaded, leaving it alone"
		exit 0
	fi
	logger -t sp11-bt-recover "btintel_pcie still '$state' after 60 s, its init has not returned; not reloading"
	exit 1
fi

# Stop bluetoothd, unload, check that the unload took, load again and wait for
# an address. Firmware download takes a few seconds; wait for a real address
# before logging, otherwise the log reports the pre-recovery state and looks
# like a failure. The 15 s also outlasts a failing setup, so a second unload
# does not land in the middle of one.
reload() {
	systemctl stop bluetooth
	# btintel goes too, when nothing else uses it.
	err=$(modprobe -r btintel_pcie 2>&1)
	if lsmod | grep -q "^btintel_pcie "; then
		logger -t sp11-bt-recover "unload failed, btintel_pcie is still loaded: ${err:-modprobe -r gave no reason}"
		systemctl start bluetooth
		return 1
	fi
	[ -z "$err" ] || logger -t sp11-bt-recover "modprobe -r btintel_pcie: $err"
	sleep 2
	modprobe btintel_pcie
	systemctl start bluetooth
	i=0
	while [ $i -lt 15 ]; do
		addr=$(real_addr)
		[ -n "$addr" ] && return 0
		sleep 1; i=$((i+1))
	done
	return 1
}

logger -t sp11-bt-recover "controller came up dead, reloading btintel_pcie ($why; waited $i s)"
if reload; then
	logger -t sp11-bt-recover "recovered: $addr"
	exit 0
fi
# The race can strike the reload too. Once more, then give up and say so.
logger -t sp11-bt-recover "first reload did not recover the controller, trying once more"
if reload; then
	logger -t sp11-bt-recover "recovered on the second reload: $addr"
	exit 0
fi
logger -t sp11-bt-recover "reload did not recover the controller, twice"
exit 1
